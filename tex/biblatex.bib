@article{Varjakoski_Tiilikainen_2025,
 journal={Sosiaalil\"a\"aketieteellinen Aikakauslehti},
 volume={62},
 month={Feb.},
 year={2025},
 number={1},
 pages={153-165},
 author={Varjakoski Hanna and Tiilikainen Elisa},
 title={Digitaalisten terveyspalveluiden k\"ayt\"on haasteet ja
  rajoitteet 75 vuotta t\"aytt\"aneiden kansalaisten kokemana},
 url={https://journal.fi/sla/article/view/143514},
 DOI={10.23990/sa.143514},
 abstract={Julkiset terveyspalvelut ovat digitalisoituneet nopeasti niin
  Suomessa kuin muualla maailmalla. Muutoksen taustalla on pyrkimys
  palveluiden parempaan saavutettavuuteen ja kansalaisten osallistamiseen
  oman terveyden seurannassa ja hoidossa. Samanaikaisesti merkitt\"av\"a osa
  i\"akk\"aimm\"ast\"a v\"aest\"ost\"a uhkaa j\"a\"ad\"a niiden ulkopuolelle.
  Tutkimuksen tarkoituksena on tarkastella millaisia haasteita ja rajoitteita
  75 vuotta t\"aytt\"aneet kansalaiset kokevat digitaalisia terveyspalveluita
  k\"aytt\"aess\"a\"an, ja millaisia tekij\"oit\"a niiden taustalla on.
  Tutkimusaineistona on k\"aytetty laadullisia haastatteluja (N=24), joiden
  yhteydess\"a hy\"odynnettiin media-go-along -menetelm\"a\"a. Tulokset
  osoittavat digitaalisten terveyspalvelujen k\"ayt\"on haasteiden ja
  rajoitteiden liittyv\"an erityisesti verkkosivujen kehnoon
  k\"aytett\"avyyteen, digitaalisen ajanvarauksen ongelmiin sek\"a
  digipalveluiden koettuun kasvottomuuteen ja reaaliaikaisuuden puutteeseen.
  Lis\"aksi digitaalisten palveluiden k\"aytt\"o\"a haastoivat tai
  rajoittivat yksil\"o\"on liittyvin\"a tekij\"oin\"a digiosaamisen ja
  -v\"alineiden puute, haluttomuus k\"aytt\"a\"a digitaalisia palveluita
  sek\"a fyysiset ja kognitiiviset muutokset. Tutkimus tuottaa uutta tietoa
  siit\"a, miten julkisten digitaalisten terveyspalveluiden
  k\"aytt\"aj\"al\"aheisyys todellisuudessa toteutuu i\"akk\"aiden
  k\"aytt\"aj\"aryhmien n\"ak\"okulmasta ja tuo n\"akyviin tarpeen
  kiinnitt\"a\"a entist\"a enemm\"an huomiota digitaalisten palveluiden
  saavutettavuuteen osana palveluiden suunnittelua ja kehitt\"amist\"a.}
}

@article{Pajula_Hanninen_Korpela_Taipale_2024,
 journal={First Monday},
 number={9},
 month={Sep.},
 year={2024},
 volume={29},
 DOI={10.5210/fm.v29i9.13330},
 title={Exploring stakeholder perspectives on user
  involvement in designing digital public services for older adults},
 author={Pajula Laura and H\"anninen
  Riitta and Korpela Viivi and Taipale Sakari},
 url={http://firstmonday.org/ojs/index.php/fm/article/view/13330},
 abstract={Digital public services can enhance well-being but also increase
  inequalities in society. Drawing from the Access Rainbow Model, we
  investigate user involvement in designing digital public services for and
  with older adults from the perspectives of Finnish stakeholders. First, (1)
  we ask what the typical challenges for older adults are accessing digital
  public services according to the stakeholders. Second, (2) we explore how
  stakeholders view the involvement of older adults in designing digital
  public services. Our research data consists of 20 semi-structured
  interviews conducted among Finnish stakeholders from local-, regional-, and
  state-level public administrations and non-governmental organizations in
  2021. Based on the data-led inductive thematic analysis, we argue that
  despite recognizing the heterogeneity among older adults, stereotypical
  assumptions continue to influence the design process. User involvement is
  viewed as a valuable but currently unimplemented practice, as no one
  presently bears the responsibility for involving users in the design
  process.}
}

@thesis{Pajula2026,
 series={JYU Dissertations},
 year={2026},
 number={1167},
 issn={2489-9003},
 author={Pajula Laura},
 isbn={978-952-86-1724-2},
 publisher={Jyv\"askyl\"an yliopisto},
 url={http://urn.fi/URN:ISBN:978-952-86-1724-2},
 organization={Faculty of Humanities and Social Sciences},
 title={Does one size fit most? :
  rethinking access to digital public services in later life},
 abstract={In digitalised welfare states such as Finland, interaction between
  citizens and public authorities is increasingly organised through
  digital-by-default services. At this intersection, older adults are
  frequently positioned on the disadvantaged side of the digital divide. At
  the same time, digital public services are often designed according to a
  'one size fits most' logic. Such framings and design principles obscure the
  heterogeneity of older adults and shift attention away from the social,
  structural and technological conditions through which access to digital
  public services is shaped in later life. Building on three original
  articles, this doctoral dissertation examines how access to digital public
  services emerges in later life as a multilayered and relational phenomenon.
  Conceptually, the study revisits discussions of digital divides by applying
  a multidimensional understanding of access. To capture the relational
  dynamics of access, an affordance perspective is further integrated in the
  study. Drawing on interviews of public sector and non-governmental
  stakeholders involved in the digitalisation of public services, as well as
  volunteer peer tutors who support older adults' digital engagement, the
  study addresses two research questions: 1) What elements of access emerge
  in using digital public services in later life from stakeholders and peer
  tutors' perspectives? and, building on these elements, 2) How is access to
  digital public services in later life shaped through the relational
  interplay of social and structural conditions in technological
  environments? Based on an inductive thematic analysis, the findings
  demonstrate that access to digital public services in later life consists
  of interrelated elements that are shaped through societal expectations,
  technological environments, and individual and social conditions. Although
  inclusion is a widely acknowledged political goal, responsibility for
  enhancing access remains fragmented across governance levels. Peer tutors,
  in turn, act as key mediators between digital-by-default policy agendas and
  older adults' everyday realities. The dissertation contributes to ageing
  and technology studies by reconceptualising access and demonstrating how
  digital inequalities persist even in highly digitalised societies. It also
  reveals the importance of governance and the design of digital public
  services in matters of access.}
}

@article{MaC6742,
 journal={Media and Communication},
 volume={11},
 number={3},
 year={2023},
 pages={53--62},
 issn={2183-2439},
 doi={10.17645/mac.v11i3.6742},
 title={Older Adults Learning Digital Skills Together:
  Peer Tutors' Perspectives on Non-Formal Digital Support},
 author={Viivi Korpela and Laura Pajula and Riitta H\"anninen},
 keywords={digital inclusion; digital skills; informal learning;
  non-formal learning; older adults; peer support; peer tutor},
 url={http://cogitatiopress.com/mediaandcommunication/article/view/6742},
 abstract={In later life, digital support is predominantly received outside
  of formal education from warm experts such as children, grandchildren, and
  friends. However, as not everyone can rely on this kind of informal help,
  many older adults are at risk of being unwillingly left without digital
  support and necessary digital skills. In this article, we examine
  non-formal digital support and peer tutoring as a way to promote digital
  and social inclusion through the acquisition of necessary digital skills.
  First, we ask: (a) What is peer tutoring, in the field of digital training,
  from the peer tutors' point of view? Then, based on the first research
  question, we further ask (b) what are the key characteristics of peer
  tutoring in relation to other forms of digital support? Our thematic
  analysis is based on semi-structured interviews (n = 21) conducted in
  Central Finland in 2022 with peer tutors aged between 63 and 84. Peer
  tutors offered individual guidance by appointment and also supported their
  peers in group-based settings. Based on our study, we argue that from the
  peer tutors' point of view, being a peer entails sharing an age group or a
  similar life situation and provides an opportunity for side-by-side
  learning. Although every encounter as a peer tutor is different and the
  spectrum of digital support is wide, these encounters share specific key
  characteristics, such as the experience of equality between the tutor and
  the tutee that distinguishes non-formal peer support from formal and
  informal learning.}
}

@article{Pajula2025,
 journal={Universal Access in the Information Society},
 volume={24},
 issue={3},
 year={2025},
 date={2025-08-01},
 pages={2783--2792},
 issn={1615-5297},
 doi={10.1007/s10209-025-01232-4},
 url={http://doi.org/10.1007/s10209-025-01232-4},
 author={Pajula Laura-Korpela Viivi-H\"anninen Riitta-Taipale Sakari},
 title={Delving into the mental access of using digital
  public services in later life - peer tutors' perspective},
 abstract={In today's society shaped by digitalization and increased number
  of digital public services, the use of digital services may be driven by
  societal rather than individual will. Mental access precedes obtaining
  physical access, skills, and usage. It can either support or hinder the
  adoption and use of diverse digital technologies and services. However,
  less is known about older adults' mental aspects on using digital public
  services. Peer tutors, acting as mediators between individual and
  societal dynamics, provide valuable insights into the mental access of
  using digital public services in later life. In this study, we ask: What
  are the key aspects of mental access according to peer tutors regarding
  the use of digital public services in later life? The data consists of 21
  semi-structured interviews conducted in Central Finland in 2022 with peer
  tutors aged between 63 and 84 years old. Based on the inductive thematic
  analysis, our findings suggest that older adults experience ambivalent
  aspects of mental access when using digital public services. Participants
  expressed concerns towards the rapidly digitalizing society and felt
  external pressure to use digital services. On the other hand, digital
  services also made tutors' and their tutees' daily lives easier. Mental
  and digital support were key facilitators to mental access,
  counterbalancing the fear and frustration that older adults may have
  towards digital services. This research sheds light on mental access
  related to the use of digital public services among older adults,
  deepening the understanding of potential mental barriers and
  facilitators.}
}

@thesis{Korpela2025,
 series={JYU Dissertations},
 year={2025},
 issn={2489-9003},
 isbn={978-952-86-1070-0},
 author={Korpela Viivi},
 url={http://urn.fi/URN:ISBN:978-952-86-1070-0},
 publisher={Jyv\"askyl\"an yliopisto},
 organization={Faculty of Humanities and Social Sciences},
 title={Signing in to society : reflections on
  digital skills, support, and inclusion in later life},
 abstract={
  Participation in modern society continues to demand digital skills. At the
  same time, the population is aging, and older adults are facing a
  disproportionate risk of being digitally marginalized. Building on three
  original research papers, this dissertation explores how older adults
  navigate digital transformation, acquire digital skills, and actively find
  ways of signing in, or engaging with, society as digital citizens in
  Finland. This study draws from discussions around digital inclusion,
  digital citizenship, and learning digital skills in later life. Based on
  qualitative interviews and thematic analyses, this dissertation examines
  the barriers and facilitators of digital skill acquisition, delves into the
  role of informal and non-formal digital support in later life, and
  investigates how older adults engage with the society as digital citizens,
  often in ways that challenge simple categorizations. For this objective,
  the study attends not only to the voices of older adults receiving digital
  support, but also to peer tutors providing it. In addition, although the
  views of warm experts (i.e. family and friends) are not captured through
  direct interviews, they become apparent in older adults and peer tutors'
  experiences and are thus reflected in this dissertation. Results portray
  the acquisition of novel digital skills in later life as a non-linear
  process, often shaped by emotional factors and shifting social roles, as
  well as necessity and opportunity. Notably, from the perspective of older
  adults and peer tutors, digital support is often perceived as a social
  event, with elements of companionship, reciprocity, and occasional
  conflict, rather than being just a technical endeavor. To reflect the
  diversity of digital engagement in later life, this dissertation introduces
  the notion of situational digital citizenship that emphasizes instances
  where older adults use digital technologies reluctantly, under duress, or
  demonstrate a more selective approach to digital participation,
  participating or opting out depending on the situation. Based on the
  findings, this research challenges binary discourses that represent older
  adults as either digitally included or excluded. Instead, the various
  pathways, facilitators, and obstacles to digital engagement should be
  acknowledged. Finally, the study calls for more sustainable models of
  digital support, bridging formal, non-formal and informal networks and
  welcoming older adults as active contributors when constructing a digital
  society.}
}

